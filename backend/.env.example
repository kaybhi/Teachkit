# Copy to .env and fill in real values. Never commit the real .env.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=teachkit

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# AI generation — direct Anthropic key (replaces Emergent's EMERGENT_LLM_KEY
# gateway, which only worked while hosted on Emergent's platform).
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Optional
CORS_ORIGINS=*
