# Copy to .env and fill in real values. Never commit the real .env.

# MongoDB
MONGO_URL=mongodb://localhost:27017
DB_NAME=teachkit

# Auth
JWT_SECRET=change-me-to-a-long-random-string
JWT_ALGORITHM=HS256

# AI generation — direct Anthropic key (replaces Emergent's EMERGENT_LLM_KEY
# gateway, which only worked while hosted on Emergent's platform).
ANTHROPIC_API_KEY=sk-ant-YOUR_KEY_HERE

# Billing — Stripe (test mode keys until business registration is confirmed
# to cover selling this; see HANDOFF.md). Leaving these unset is fine for
# everything except actually hitting the /billing/* endpoints.
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE
STRIPE_PRICE_ID_MONTHLY=price_YOUR_MONTHLY_PRICE_ID
STRIPE_PRICE_ID_ANNUAL=price_YOUR_ANNUAL_PRICE_ID
FRONTEND_URL=https://theteachkit.com

# Optional
CORS_ORIGINS=*
